// Forge Database Schema
// Uses SQLite via libSQL for platform-agnostic deployment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Project represents an uploaded repository or cloned git repo
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  repoUrl     String?
  status      String   @default("active") // active | archived | deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  runs        Run[]
  secrets     Secret[]
  
  @@index([status])
  @@index([createdAt])
}

// Run represents a single CI/CD execution
model Run {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflow   String
  status     String    @default("queued") // queued | running | success | failed | canceled
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  exitCode   Int?
  logs       String?
  
  @@index([projectId])
  @@index([status])
  @@index([startedAt])
}

// Secret stores encrypted environment variables
model Secret {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  value     String   // Encrypted
  createdAt DateTime @default(now())
  
  @@unique([projectId, name])
}

// AuditLog tracks all system actions
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String?
  details   String?
  createdAt DateTime @default(now())
  
  @@index([createdAt])
  @@index([action])
}
